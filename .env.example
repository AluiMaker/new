# Chave secreta da sessão Flask (gere uma string aleatória longa em produção)
SECRET_KEY=troque-por-uma-chave-secreta-forte

# Conta administradora inicial (criada automaticamente se não houver usuários no banco)
ADMIN_EMAIL=admin@mapaleads.pro
ADMIN_PASSWORD=troque-essa-senha

# Token de verificação do Webhook da API Oficial do WhatsApp (Meta)
META_VERIFY_TOKEN=mapaleads_webhook_2026

# Cadastro Incorporado da Meta (Embedded Signup estilo Kommo - requer HTTPS em produção)
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_CONFIG_ID=
META_API_VERSION=v21.0

# Caminho do banco SQLite (em produção aponte para um volume persistente, ex: /data/mapaleads.db)
DATABASE_PATH=mapaleads.db

# Controle de Assinaturas, Trial & Segurança
ALLOW_PUBLIC_SIGNUP=1
MAX_CONCURRENT_SEARCHES=1
BILLING_WEBHOOK_SECRET=troque-por-um-token-secreto-do-webhook
CHECKOUT_URL=https://pay.kiwify.com.br/seu-link-aqui

